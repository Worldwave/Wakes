+void udc_nrf_iso_in_fast_set(udc_nrf_iso_in_fill_t fill, void *user_data, bool suppress_sof)
+{
+	unsigned int key = irq_lock();
+
+	iso_fast_user_data = user_data;
+	iso_fast_suppress_sof = suppress_sof;
+	iso_fast_fill = fill;
+	if (fill == NULL) {
+		/* A packet requested but not yet DMA'd is dropped; one in flight
+		 * completes normally (iso_fast_dma).
+		 */
+		m_ep_dma_waiting &= ~BIT(ep2bit(NRF_USBD_COMMON_EPIN8));
+	}
+
+	irq_unlock(key);
+}
+
+void udc_nrf_iso_in_fast_stats_get(struct udc_nrf_iso_in_fast_stats *stats)
+{
+	unsigned int key = irq_lock();
+
+	*stats = iso_fast_stats;
+	irq_unlock(key);
+}
