+
+/* ISO IN fast path at SOF: take this frame's packet from the application and
+ * request its DMA, which usbd_dmareq_process() starts at the end of this same
+ * interrupt. Returns true if the fast path is active.
+ */
+static bool iso_fast_sof(void)
+{
+	const udc_nrf_iso_in_fill_t fill = iso_fast_fill;
+	const uint32_t bit = BIT(ep2bit(NRF_USBD_COMMON_EPIN8));
+	uint8_t *buf;
+	uint16_t len;
+
+	if (fill == NULL || !(NRF_USBD->EPINEN & BIT(NRF_USBD_COMMON_EP_NUM(NRF_USBD_COMMON_EPIN8)))) {
+		return false;
+	}
+
+	if (m_ep_dma_waiting & bit) {
+		/* Last frame's packet never got the DMA (another endpoint held it
+		 * across the whole frame): it is stale, send this frame's instead.
+		 */
+		iso_fast_stats.replaced++;
+	}
+
+	buf = (uint8_t *)iso_fast_buf[iso_fast_next];
+	len = fill(buf, UDC_NRF_ISO_IN_FAST_MAX, iso_fast_user_data);
+	if (len == 0) {
+		m_ep_dma_waiting &= ~bit;
+		iso_fast_stats.empty++;
+		return true;
+	}
+
+	iso_fast_ptr = buf;
+	iso_fast_len = MIN(len, UDC_NRF_ISO_IN_FAST_MAX);
+	iso_fast_next ^= 1;
+	m_ep_dma_waiting |= bit;
+
+	return true;
 }
 
