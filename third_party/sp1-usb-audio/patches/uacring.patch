+/* Wakes (M5c): one 32-bit word per stereo frame instead of memcpy/memset. The SDK's
+ * picolibc copies ONE BYTE per loop pass (~6.6 cycles a byte on the SP-1, issue #36), and
+ * these run every 2 ms in the audio thread (push) and every 1 ms in the USB interrupt
+ * (pop): ~4 points of CPU through the library, ~0.5 this way. A frame is two int16_t, so
+ * every frame is a whole word. The buffers are at least 2-byte aligned (int16_t); the
+ * word type says so, and the Cortex-M4 loads and stores such words with single LDR/STR.
+ * ⚠️ Compiled with -fno-tree-loop-distribute-patterns, or GCC turns these loops straight
+ * back into memcpy/memset calls (sp1_zero.cc, #36). */
+typedef uint32_t __attribute__((aligned(2), may_alias)) uac_frame_t;
+
+static void frames_copy(int16_t *dst, const int16_t *src, uint32_t frames)
+{
+	uac_frame_t *d = (uac_frame_t *)dst;
+	const uac_frame_t *s = (const uac_frame_t *)src;
+
+	for (; frames >= 4u; frames -= 4u) {
+		const uint32_t f0 = s[0], f1 = s[1], f2 = s[2], f3 = s[3];
+
+		d[0] = f0; d[1] = f1; d[2] = f2; d[3] = f3;
+		d += 4;
+		s += 4;
+	}
+	for (; frames != 0u; frames--) {
+		*d++ = *s++;
+	}
+}
+
+static void frames_zero(int16_t *dst, uint32_t frames)
+{
+	uac_frame_t *d = (uac_frame_t *)dst;
+
+	for (; frames != 0u; frames--) {
+		*d++ = 0u;
+	}
+}
