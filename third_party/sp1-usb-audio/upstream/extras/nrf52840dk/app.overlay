/* SPDX-License-Identifier: Apache-2.0
 *
 * One UAC2 function: a 48 kHz, 16-bit stereo capture stream to the host --
 * the device appears as an audio INPUT on the computer. No ISO OUT and no
 * feedback endpoint, so nothing but the capture stream needs SOF events.
 */
#include <zephyr/dt-bindings/usb/audio.h>

/ {
	uac2_synth: usb_audio2 {
		compatible = "zephyr,uac2";
		status = "okay";
		full-speed;
		audio-function = <AUDIO_FUNCTION_MUSICAL_INSTRUMENT>;

		uac2_synth_clock: clock {
			compatible = "zephyr,uac2-clock-source";
			clock-type = "internal-fixed";
			frequency-control = "read-only";
			sampling-frequencies = <48000>;
		};

		uac2_synth_in: synthesizer {
			compatible = "zephyr,uac2-input-terminal";
			clock-source = <&uac2_synth_clock>;
			terminal-type = <EMBEDDED_TERMINAL_SYNTHESIZER>;
			front-left;
			front-right;
		};

		uac2_usb_out: usb_out {
			compatible = "zephyr,uac2-output-terminal";
			data-source = <&uac2_synth_in>;
			clock-source = <&uac2_synth_clock>;
			terminal-type = <USB_TERMINAL_STREAMING>;
		};

		uac2_capture: capture {
			compatible = "zephyr,uac2-audio-streaming";
			linked-terminal = <&uac2_usb_out>;
			subslot-size = <2>;
			bit-resolution = <16>;
		};
	};
};
