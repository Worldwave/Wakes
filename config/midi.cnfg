; Format: ini
; =====================================================================================
;  Wakes — MIDI
; =====================================================================================
;
;  This file configures Wakes' MIDI handling. Wakes reads this file from its drive
;  (WAKES/CNFG/midi.cnfg) every time it turns ON, so a change takes effect at the next ON.
;
;  Lines starting with ; or # are comments. Every setting can be left out to get its
;  default. A line Wakes cannot read keeps its default, and the log (WAKES/LOGS/) names it.
;  If two of your lines give the same CC, the first one keeps it and the later one gets
;  none. A CC you give a parameter is taken from whichever parameter had it by default.
;  The CC chart that comes with each Wakes release lists the default CCs.

[midi]
; Which MIDI channel Wakes listens on: 1-16, or omni (every channel).
channel        = omni

; note_priority - Plaits is a monophonic synthesizer. When several keys are held, determines 
;   which one you hear:
;   last = the most recently pressed key (most mono synths).
;   low  = the lowest key held -- a bass line that ignores notes played above it.
;   high = the highest key held -- a lead that ignores notes played below it.
; Wakes remembers up to 12 held keys. Let go of the one sounding and the next by the same
; rule takes over if it is still held (with `last`: the one pressed before it).
note_priority  = last

; legato - What happens when a new note takes over while another key is still held:
;   off  = it strikes TRIG again, like a new note, and so does falling back to a key still
;          held. Every note is articulated. Portamento (below) applies to every note.
;   on   = no reTRIG: the pitch moves to the new note while the sound carries on,
;          as on a monosynth played legato. Only a note played after letting go of every
;          key strikes. Portamento applies to every note.
;   auto = as on, and portamento ONLY between overlapping notes: play legato to glide,
;          detached to jump straight to the next note (with a strike) -- portamento under
;          your fingers rather than always on.
; The same pitch played again before its note-off -- a sequencer's notes longer than its
; step -- strikes again in off, and is tied into one long note in on and auto. Either way it
; ends at the LAST of its note-offs, not the first.
legato         = auto

; portamento - the pitch glides from one note to the next instead of jumping. 
;   0         = none.
;   t1 .. t50 = constant TIME: every glide takes the same time, whatever the interval.
;               The curve is exponential -- fast at first, then settling into the note,
;               the way an analog glide (a capacitor charging) sounds -- and it lands
;               exactly on the note at the set time.
;   r0 .. r50 = constant RATE: the pitch moves in a straight line at a fixed speed, so a
;               wider interval takes longer. The time below is per octave: a fifth takes
;               7/12 of it, two octaves twice it.
; The scale is steep, finest at the short end. Glide time (t), or time per octave (r):
;   1 ~ 1 ms   5 ~ 6 ms   10 ~ 22 ms   20 ~ 135 ms   30 ~ 0.47 s   40 ~ 1.2 s   50 ~ 2.6 s
; (r0 is under 1 ms per octave: practically instant.)
portamento     = t9

; bend_range - Pitch bend range in semitones, 0-24. If the host sends its own bend range
; (RPN 0, "pitch bend sensitivity"), Wakes uses the host's until unplugged.
bend_range     = 2

; The sustain pedal: cc N, or off. CC 64 is the standard pedal.
sustain        = cc 64

; cc_smoothing - How long a CC takes to glide to a new value, in milliseconds (0-200). 
; This is what turns a CC's steps into a smooth movement instead of zipper noise. 
cc_smoothing   = 10

; clock - controls whether Marbles receives MIDI clock and transport.
;   on  = Marbles' clock syncs with the host's clock when it receives a tick or start message.
;         Marbles' RATE fader then picks a ratio of the host's beat instead of a tempo: 
;         1/4, 1/3, 1/2, 2/3, 1, 3/2, 2, 3, 4. DIV+/- selects a subdivision of that ratio.
;   off = disabled.
clock          = on

; clock_lead - Determines how far ahead of the host's clock Marbles will compensate.
;   notes (default) = Marbles will intelligently switch between MIDI note-based clock
;     delay compensation and its own auto-switching delay compensation (below).
;   auto = Wakes' own delay (8.5 ms): Marbles' beats leave the output when the clock's do.
;     While the host is recording Wakes over USB audio, that output is 1 ms later, and
;     auto (and notes, until it has measured) follows it: 9.5 ms.
;   0-200 = that many ms, for a host whose clock offset you would rather set here.
;   Tips:
;     With the 'notes' or 'auto' options, leave the host's own clock offset / sync delay 
;     for Wakes at 0.
;     Wakes outputs sound with a small delay after the triggers that cause it. Audio can't 
;     be played early, but a clock can: it is steady, so Wakes can read ahead and compensate 
;     to play tighter.
clock_lead     = notes

; pickup - How a CC and its fader share a parameter. A control that does not match the value
; does not jump - moving it moves the value the same way from where it is, a little faster
; or slower, until the two meet and continue together.
;
;   sum      = the CC is an OFFSET on top of the fader: fader + CC. A parameter whose
;              middle is neutral reads its CC centred (64 = no change, 0 / 127 = half a
;              travel down / up); any other reads it one-sided (0 = no change, 127 = a
;              whole travel up); TIMBRE / MORPH / HARMONICS follow the engine, and when an
;              engine change flips how one reads, the offset catches up instead of jumping.
;              Unplug and every offset goes back to zero.
;   shared   = the CC and the fader are two hands on ONE value. A CC reads like the fader
;              (0 = the bottom, 127 = the top). Whichever you move takes the value from
;              where the other left it and catches up with your hand.
;   takeover = while MIDI is plugged in, the faders that have a CC here REST, and only the
;              CC moves the parameter (catching up with where the fader left it). Unplug and
;              the faders work again, catching up with where the CC left it.
;
; In shared and takeover the CC moves the parameter itself: the fader LEDs show where the
; host put it, and it stays there when you unplug. A host knob's FIRST value after plugging
; in -- including the snapshot some hosts send when they connect -- only tells Wakes where
; the knob is; nothing moves until you turn it.
; MODEL has no fader, so it is an offset in every setting (see [plaits]), and so are the
; [bind] sources at the end of this file.
pickup         = shared

; -------------------------------------------------------------------------------------
;  MIDI CC Assignments
;  
;  Example:
;
;    name = cc N   (or none)
;
;  CC 0-31 are 14-bit: Wakes also listens to their partner CC N+32 for the fine half of
;  the value, which is how a host sends high-resolution CCs. A host that only sends the
;  coarse half still works. Any other CC is 7-bit (128 steps), smoothed.
;  For this reason, CCs 33-63 can't be assigned. Wakes will refuse them.
;
;  The defaults below use only CC numbers that keyboards and DAWs do not send on their
;  own (the undefined ones, and General Purpose 1-4 = CC 16-19), so out of the box
;  nothing moves until you point something at it. The mod wheel (1), breath (2), foot
;  (4), portamento time (5) and expression (11) are deliberately left free for you.
;
;  The following MIDI CCs are not allowed for parameter control, 
;  as they are taken up by other functions:
;    CC 0 and its fine-half CC 32 (bank select)
;    CC 6 and its fine-half CC 38 (data entry)
;    CC 96-101 (data entry and parameter numbers -- needed for the host's bend range)
;    CC 120-127 (channel mode messages)
;    CC 33-63 (discussed above)
;
;  How a CC reads depends on `pickup` (refer to the explanation above).
; -------------------------------------------------------------------------------------




[plaits]
; BASE page
timbre               = cc 3
morph                = cc 9
harmonics            = cc 14
frequency            = cc 15

; SHIFT page: the four attenuverters
fm_attenuverter        = cc 20
timbre_attenuverter    = cc 21
morph_attenuverter     = cc 22
harmonics_attenuverter = cc 23

; SETTINGS page
lpg_colour           = cc 24
lpg_decay            = cc 25
level                = cc 26
octave_range         = cc 102
; model - Selects which engine plays, as an offset from the one T2/T3 selected,
;   up through the filled slots of engines.cnfg (0 = the selected engine, 127 = the
;   last slot). Changing MODEL will flash the slot glyph, as T2/T3 do.
;   MIDI changes the engine at most every 50 ms -- each change costs the audio thread 
;   a brief CPU spike, as a T2/T3 press does.
model                = cc 105




[marbles]
; t page
rate                 = cc 27
t_bias               = cc 16
jitter               = cc 85
deja_vu              = cc 31

; t SHIFT page
gtlt                 = cc 89
gate_length          = cc 17
gate_length_random   = cc 86
length               = cc 103

; X page
spread               = cc 28
x_bias               = cc 29
steps                = cc 30

; SETTINGS (Y) page
y_spread             = cc 18
y_bias               = cc 19
y_steps              = cc 87
y_divider            = cc 104




; -------------------------------------------------------------------------------------
;  Extra sources.
;
;    velocity   = <parameter> [<depth>%]    how hard each note was played
;    aftertouch = <parameter> [<depth>%]    channel pressure
;
;  <parameter> is any parameter name pasted from the two MIDI CC parameter lists above 
;  (or `none`), and an optional depth setting -100% .. 100% (100% if unset).
;  The source offsets that parameter by up to its full travel at 100%, regardless of the
;  `pickup` setting selected above.
;
;  Aimed at `level`, it sets how far each note opens LEVEL instead, which Plaits also reads
;  similarly to an accent modulation: soft notes are quieter and darker. 
;  At 100%, the hardest note opens the LPG fully, and at 0%, velocity is functionally 
;  disabled. To play every note at full LEVEL, disconnect velocity by setting it to `none`.
;
;  You can also do this on the host instead: most DAWs can turn velocity or pressure
;  into a CC, and aim it at the CC of the parameter you want.
;
;  Examples:
;
;    velocity   = level
;    aftertouch = timbre 50%
;
; -------------------------------------------------------------------------------------

[bind]
velocity           = none
aftertouch         = none
