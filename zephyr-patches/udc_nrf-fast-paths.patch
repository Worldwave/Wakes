+#if defined(CONFIG_UDC_NRF_OUT_FAST)
+/* Bulk OUT fast path (udc_nrf_fast.h). While active, the endpoint's DMA-waiting bit stays
+ * set: each packet the host sends makes it ready, usbd_dmareq_process() DMAs it into
+ * out_fast_buf at the end of that same interrupt, and nrf_usbd_dma_finished() hands it to
+ * the callback. The peripheral re-arms an OUT endpoint by itself after its DMA, so the host's
+ * next packet is accepted with no thread involved. One buffer is enough: the callback returns
+ * before the interrupt that delivered it can start the next DMA.
+ */
+static udc_nrf_out_fast_cb_t out_fast_cb;
+static void *out_fast_user_data;
+static uint8_t out_fast_ep;
+static bool out_fast_active;
+/* True from DMA start until DMA end of a fast-path packet. */
+static bool out_fast_dma;
+static uint16_t out_fast_len;
+static uint32_t out_fast_buf[UDC_NRF_OUT_FAST_MAX / sizeof(uint32_t)];
+static struct udc_nrf_out_fast_stats out_fast_stats;
+#endif
+
+#if defined(CONFIG_UDC_NRF_ISO_IN_FAST)
+/* ISO IN fast path (udc_nrf_fast.h), Ryan Gilmore's, from sp1-usb-audio. When registered,
+ * ev_sof_handler() asks the application for the next ISO IN packet and usbd_dmareq_process()
+ * DMAs it from iso_fast_buf at the end of the same interrupt, so no thread is woken per
+ * frame. Two buffers: a DMA may still be running across SOF (see ev_sof_handler), and the
+ * next packet must not be written under it.
+ */
+static udc_nrf_iso_in_fill_t iso_fast_fill;
+static void *iso_fast_user_data;
+static bool iso_fast_suppress_sof;
+static uint32_t iso_fast_buf[2][UDC_NRF_ISO_IN_FAST_MAX / sizeof(uint32_t)];
+static uint8_t iso_fast_next;
+static uint8_t *iso_fast_ptr;
+static uint16_t iso_fast_len;
+/* True from DMA start until DMA end of a fast-path packet. */
+static bool iso_fast_dma;
+static struct udc_nrf_iso_in_fast_stats iso_fast_stats;
+#endif
